[Unit]
Description=DwarfStar DeepSeek V4 Flash proof of concept
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/dwarfstar
ExecStart=%h/dwarfstar/ds4-server --rocm -m /mnt/ai-models/dwarfstar/DeepSeek-V4-Flash-IQ2XXS-w2Q2K-AProjQ8-SExpQ8-OutQ8-chat-v2-imatrix-0731.gguf --ctx 4096 --host 127.0.0.1 --port 8000
Restart=no
TimeoutStopSec=120
KillMode=control-group
UMask=0077

[Install]
WantedBy=default.target
