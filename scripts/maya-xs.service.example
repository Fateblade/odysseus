[Unit]
Description=Experimental Maya DeepSeek V4.1 Flash XS
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/project-maya-xs
ExecStartPre=/usr/bin/python3 /mnt/odysseus-fateblade/scripts/odysseus-maya-memory-check.py --minimum-available-gib 16
ExecStart=%h/project-maya-xs/.venv/bin/python -m serve.server --engine strata --config %h/project-maya-xs/maya-ds4-hip.json --host 127.0.0.1 --port 8092
Restart=no
TimeoutStopSec=120
KillMode=control-group
UMask=0077

[Install]
WantedBy=default.target
